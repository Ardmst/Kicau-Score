# Konfigurasi Nginx untuk kicaumania.ardmst.my.id
# Letakkan di VPS: /etc/nginx/sites-available/kicaumania.ardmst.my.id
# Lalu symlink ke: /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name kicaumania.ardmst.my.id;

    # Root harus mengarah ke direktori public Laravel
    root /var/www/kicauscore/public;

    # Keamanan: Batasi upload body size
    client_max_body_size 15M;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";

    index index.php index.html;
    charset utf-8;

    # Routing Laravel
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    # Eksekusi PHP-FPM (sesuaikan versi PHP di VPS, e.g. php8.3-fpm atau php8.4-fpm)
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # KEAMANAN: Blokir akses langsung ke file .env, .git, dan file tersembunyi
    location ~ /\.(env|git|svn|htaccess) {
        deny all;
        return 404;
    }

    # KEAMANAN: Blokir akses langsung ke file database SQLite
    location ~ \.(sqlite|sqlite3|db)$ {
        deny all;
        return 404;
    }

    # Caching aset statis (CSS, JS, Fonts, Images)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
